# The Next.js same-origin proxy defaults to this local engine URL.
ENGINE_API_URL=http://127.0.0.1:8100

# fixture (default) or public. Public imports write data/public.duckdb.
SIGNAL_ENGINE_CORPUS_MODE=fixture
# SIGNAL_ENGINE_DB_PATH=C:\absolute\path\to\custom.duckdb

# Live narration is disabled by default. Set both only for an explicitly
# budgeted smoke run; ordinary tests and demos use deterministic templates.
# OPENAI_API_KEY=
# SIGNAL_ENGINE_NARRATION_MODEL=

# The latest TabPFN checkpoint requires accepting PriorLabs model terms in an
# interactive browser once. The adapter reports "unavailable" until enabled.
# TABPFN_ENABLE=1

# Lambda Cloud GPU runner (`signal-engine lambda verify|run|status|cleanup`).
# The API key has full account access and launches are billable; keep it only
# in .env.local. Region/type/key name are optional: the runner auto-selects the
# cheapest single GPU with >=40 GB that has capacity and manages its own ed25519
# key under artifacts/lambda/ssh/ unless you point it at an existing one.
# LAMBDA_API_KEY=
# LAMBDA_API_BASE_URL=https://cloud.lambda.ai/api/v1
# LAMBDA_REGION_NAME=
# LAMBDA_INSTANCE_TYPE_NAME=
# LAMBDA_SSH_KEY_NAME=
# LAMBDA_SSH_PRIVATE_KEY_PATH=
