          "title": "Content Sha256",
          "type": "string"
        },
        "landing_page": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Landing Page",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "local_path": {
          "title": "Local Path",
          "type": "string"
        },
        "retrieval_url": {
