          "items": {
            "$ref": "#/$defs/SignalPolicyEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sequence_rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SequenceRule"
          },
          "title": "Sequence Rules",
          "type": "array"
