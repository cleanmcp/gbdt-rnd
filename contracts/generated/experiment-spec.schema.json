          "type": "array"
        },
        "half_life_days": {
          "exclusiveMinimum": 0,
          "title": "Half Life Days",
          "type": "number"
        },
        "initial_weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Initial Weight",
          "type": "number"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "signal_type": {
          "title": "Signal Type",
          "type": "string"
        }
      },
      "required": [
        "signal_type",
        "initial_weight",
        "half_life_days"
      ],
      "title": "SignalPolicyEntry",
      "type": "object"
