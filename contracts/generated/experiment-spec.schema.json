{
  "$defs": {
    "GoalSpec": {
      "additionalProperties": false,
      "properties": {
        "goal_version": {
          "title": "Goal Version",
          "type": "string"
        },
        "horizon_days": {
          "maximum": 730,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_outcome": {
          "title": "Target Outcome",
          "type": "string"
        }
      },
      "required": [
        "goal_version",
        "name",
        "objective",
        "target_outcome",
        "horizon_days"
      ],
      "title": "GoalSpec",
      "type": "object"
    },
    "IcpSpec": {
