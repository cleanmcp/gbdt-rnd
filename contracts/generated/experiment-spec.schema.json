      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "candidate_multiplier": {
      "default": 3,
      "maximum": 20,
      "minimum": 1,
      "title": "Candidate Multiplier",
      "type": "integer"
    },
    "capacity": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Capacity",
      "type": "integer"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "feature_version": {
      "title": "Feature Version",
      "type": "string"
    },
    "goal": {
