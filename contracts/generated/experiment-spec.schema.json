            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "geographies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Geographies",
          "type": "array"
        },
        "icp_version": {
          "title": "Icp Version",
          "type": "string"
        },
        "industries": {
          "items": {
            "type": "string"
          },
          "title": "Industries",
          "type": "array"
        },
        "naics_prefixes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Naics Prefixes",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "operational_traits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Operational Traits",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "icp_version",
        "name",
        "industries"
      ],
      "title": "IcpSpec",
      "type": "object"
    },
    "ProductSpec": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "problems_solved": {
          "items": {
            "type": "string"
          },
          "title": "Problems Solved",
          "type": "array"
