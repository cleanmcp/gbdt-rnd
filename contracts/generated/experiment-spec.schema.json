      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "signal_contracts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Signal Contracts",
      "type": "object"
    },
